# Copy to .env and edit. Empty values count as unset.

# Docker image (docker-compose.yml): the published image is used unless you run
# `docker compose up -d --build`. Pin a dated tag to control updates, e.g. 2026.10.14-0f12bb9.
WHEREBOX_IMAGE=sacbhale/wherebox
WHEREBOX_TAG=latest

# Permanent base URL printed into every QR/NFC tag: scheme://host[:port], no path.
# Set the final value BEFORE printing tags; changing it orphans every printed tag.
PUBLIC_BASE_URL=http://localhost:8000

# Data directory (database, photos/, backups/). docker-compose.yml pins it to /data.
DATA_DIR=/data

# Owner of the data directory; the entrypoint drops to this uid/gid when started as root.
PUID=1000
PGID=1000

# Household login name (one shared login: name + password). When set, it replaces the stored
# name on start if it differs (signing everyone out once). 1-64 characters, no control
# characters, compared case-insensitively. Pick one that is not easy to guess.
# Always wins on restart (also for /setup), so it survives restoring an older backup.
# Unset and no name stored: the password alone logs in (Settings warns about it).
HOUSEHOLD_USERNAME=

# Household password. When set, it replaces the stored password on every start
# (overriding `cli set-password`). Leave unset to use the one-time /setup page.
HOUSEHOLD_PASSWORD=

# AI provider: anthropic (default), openrouter, or fake (tests). Without the provider's key,
# AI capture is disabled and manual entry still works.
AI_PROVIDER=anthropic
# The Anthropic key (AI_PROVIDER=anthropic).
AI_API_KEY=
# The OpenRouter key (AI_PROVIDER=openrouter; see "Using OpenRouter" in docs/operations.md).
OPENROUTER_API_KEY=
# Default model; the Settings page can override it when AI_PROVIDER=openrouter.
# anthropic: a vision-capable Claude Sonnet-class model id.
AI_MODEL=claude-sonnet-5-5
# openrouter: an OpenRouter id (vendor/model). This one reads images, supports tool calls and
# costs $0.25 / $1.50 per million input/output tokens (catalog of 2026-09-30):
# AI_MODEL=google/gemini-3.1-flash-lite
# Only for AI_PROVIDER=fake: JSON script of scripted results.
FAKE_AI_SCRIPT=
# Test-only: read the OpenRouter model list from this JSON file instead of openrouter.ai.
# Ignored unless AI_PROVIDER=fake.
OPENROUTER_CATALOG_FILE=

# Prices in USD per million tokens; required when MONTHLY_AI_BUDGET is set, except with
# AI_PROVIDER=openrouter (OpenRouter reports the real cost of every call).
AI_INPUT_PRICE_PER_MTOK=
AI_OUTPUT_PRICE_PER_MTOK=
# Monthly AI spend limit in USD; AI capture stops when the month's total reaches it.
MONTHLY_AI_BUDGET=

# Time zone used for monthly budget boundaries (usage is stored in UTC).
TZ=UTC

# Items below this AI confidence are flagged for review.
AI_CONFIDENCE_THRESHOLD=0.7
# Whole-call limit; a multi-photo call gets 10 more seconds per photo after the first.
AI_TIMEOUT_SECONDS=60
# Long edge in pixels of images sent to the AI.
AI_MAX_IMAGE_EDGE=1500
# Per file; a capture takes up to 6 photos (requests over 6 x this + 1 MB are refused).
MAX_UPLOAD_MB=25

# Login session lifetime in days.
SESSION_DAYS=30
# auto: Secure cookie flag follows the effective request scheme (after trusted-proxy
# handling); true: always Secure; false: never.
COOKIE_SECURE=auto
# Reverse-proxy addresses/CIDRs whose X-Forwarded-* headers are trusted (read by uvicorn).
# Unsafe with rootless Docker, Podman, userland-proxy or hairpin NAT: use the proxy's exact IP.
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
# Host address the port is published on: 127.0.0.1 (reverse proxy on this host) or
# 0.0.0.0 (direct plain-HTTP LAN access; see docs/operations.md).
BIND_ADDRESS=127.0.0.1
# Extra comma-separated hostnames accepted as request Origin (besides PUBLIC_BASE_URL's host).
ALLOWED_HOSTS=

# Start the background capture worker (tests set false).
WORKER_AUTOSTART=true
# Hours between automatic backups to backups/latest.db.
BACKUP_INTERVAL_HOURS=24
